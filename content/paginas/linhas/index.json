  "faq": [
    {
      "pergunta": "Quantas linhas de ônibus compõem a malha ativa de Ribeirão Preto?",
      "resposta": "A malha operacional oficial supervisionada pela RP Mobi é composta por 113 linhas (112 com catálogo georreferenciado completo e 1 em complementação cadastral), divididas entre serviços estruturais BRT, linhas convencionais radiais, alimentadoras de bairro e o corujão noturno."
    },
    {
      "pergunta": "Como funciona o benefício da integração temporal de 120 minutos?",
      "resposta": "Ao utilizar o Cartão Cidadão RP Mobi (ou Cartão Nosso), o passageiro tem até 2 horas (120 minutos) contadas a partir do primeiro giro de catraca para embarcar em um segundo ônibus de qualquer outra linha municipal sem pagar uma nova tarifa."
    },
    {
      "pergunta": "Onde consultar desvios e alterações de linhas por obras?",
      "resposta": "Desvios temporários decorrentes de obras viárias, eventos comemorativos e interdições são divulgados no canal oficial de Alterações e Desvios e pela central de ouvidoria da RP Mobi no telefone 0800 77 10 118."
    }
  ],
